{
  "manifest_version": 3,
  "name": "Bitbucket PR -> PyCharm",
  "version": "1.3.0",
  "description": "Open Bitbucket PR files, diffs and projects in PyCharm with one click (via a local helper, no token needed).",
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*/pull-requests/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "permissions": ["storage", "clipboardWrite"]
}
