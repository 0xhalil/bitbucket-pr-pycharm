{
  "manifest_version": 3,
  "name": "Bitbucket PR -> PyCharm",
  "version": "1.1.0",
  "description": "Bitbucket PR diff sayfasindaki dosyayi / projeyi tek tikla PyCharm'da acar (local helper uzerinden, tokensiz).",
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*/pull-requests/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "permissions": ["storage"]
}
